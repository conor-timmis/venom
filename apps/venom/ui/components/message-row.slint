import { ChatRow, ChatSegmentKind } from "../types.slint";
import { Theme } from "../theme.slint";
import { BadgeView } from "badge.slint";
import { InlineEmote } from "inline-emote.slint";

export component MessageRow inherits Rectangle {
    in property <ChatRow> message;
    callback created();

    init => {
        root.created();
    }

    height: content.preferred-height;
    background: Theme.row-background;

    content := VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 2px;

        HorizontalLayout {
            spacing: 7px;

            Text {
                text: message.timestamp;
                color: Theme.text-muted;
                font-size: 11px;
                vertical-alignment: bottom;
            }

            Text {
                text: message.platform-label;
                color: message.platform-accent;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: bottom;
            }

            for badge in message.badges : BadgeView {
                label: badge.label;
                kind: badge.kind;
            }

            Text {
                text: message.author;
                color: message.author-color;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: bottom;
            }
        }

        if (message.reply-preview != "") : Text {
            text: message.reply-preview;
            color: Theme.text-muted;
            font-size: 11px;
            overflow: elide;
        }

        // Pre-wrapped rich body. Each line is a horizontal run of text and
        // inline emote elements.
        VerticalLayout {
            spacing: 1px;

            for line in message.body : HorizontalLayout {
                spacing: 4px;

                for segment in line.segments : HorizontalLayout {
                    spacing: 0px;

                    if (segment.kind == ChatSegmentKind.text) : Text {
                        text: segment.text;
                        color: Theme.text-primary;
                        font-size: 14px;
                        wrap: no-wrap;
                    }

                    if (segment.kind == ChatSegmentKind.emote) : InlineEmote {
                        frames: segment.frames;
                        frame-delay: segment.frame-delay;
                    }

                    if (segment.kind == ChatSegmentKind.link) : Text {
                        text: segment.text;
                        color: Theme.accent;
                        font-size: 14px;
                        wrap: no-wrap;
                    }

                    if (segment.kind == ChatSegmentKind.mention) : Text {
                        text: segment.text;
                        color: Theme.accent;
                        font-size: 14px;
                        font-weight: 600;
                        wrap: no-wrap;
                    }
                }
            }
        }
    }

    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: message.platform-accent;
    }

    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.divider;
    }
}
