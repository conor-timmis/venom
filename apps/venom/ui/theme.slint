// Prototype palette. Keep presentation values here rather than in Rust.
export global Theme {
    out property <color> window-background: #0d0f13;
    out property <color> panel-background: #151820;
    out property <color> row-background: #11141a;
    out property <color> button-background: #222733;
    out property <color> button-hover: #2c3342;
    out property <color> text-primary: #e6e9ef;
    out property <color> text-muted: #8a92a6;
    out property <color> divider: #202431;
    out property <color> accent: #9d6bff;
    out property <length> follow-threshold: 24px;
}
